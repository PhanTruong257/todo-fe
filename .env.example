# URL gốc của API (giữ nguyên /api để tương thích CloudFront và Vite proxy)
VITE_API_URL=/api

# Mục tiêu của Vite Dev Proxy khi chạy local (npm run dev):
# - Test với Backend Local máy bạn: http://localhost:4000
# - Test nhanh FE với Backend Cloud EC2 (không cần bật backend local): http://13.228.71.202
VITE_BACKEND_TARGET=http://localhost:4000
